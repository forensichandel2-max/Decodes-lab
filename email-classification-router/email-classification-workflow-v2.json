    {
      "parameters": {
        "promptType": "define",
        "text": "=Email Subject: {{ $('Gmail Trigger').item.json.subject }}\n\nEmail Body:{{ $('Gmail Trigger').item.json.snippet }}\n\n\n{\n  \"category\": \"string\",\n  \"summary\": \"string\"\n}\n",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an intelligent email classification assistant for a company. Your job is to read incoming emails and:\n\n1. Classify the email into EXACTLY ONE of these departments:\n   - Sales\n   - HR\n   - Marketing\n   - Customer Service\n\n2. Write a clear, professional summary of the email (3-5 sentences) that explains exactly what the email is about — including key details like names, dates, amounts, requests, or issues mentioned. The summary should give the reading team enough context to understand the email WITHOUT needing to open it.\n\nClassification guidance:\n- Sales: inquiries about pricing, quotes, purchases, deals, contracts, leads, orders, invoices, payment negotiations\n- HR: employee matters, payroll, leave requests, recruitment, interviews, onboarding, benefits, performance, resignations\n- Marketing: campaigns, branding, promotions, content requests, social media, press releases, partnerships, advertising\n- Customer Service: complaints, support requests, product issues, refunds, returns, general customer questions or feedback\n\nIf an email could fit multiple categories, choose the one that reflects the PRIMARY intent or action needed.\n\nReturn ONLY valid JSON in this exact format:\n\n{\n  \"category\": \"Sales\",\n  \"summary\": \"Brief but detailed summary explaining what the email is about.\"\n}\n\nRules:\n- Do NOT include explanations outside the JSON\n- Do NOT use markdown or code blocks\n- Output must be valid JSON only\n"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -224,
        208
      ],
      "id": "4120e83c-3f6f-4db2-bb2b-4486959a49bf",
      "name": "AI Agent",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "gpt-4.1-mini"
