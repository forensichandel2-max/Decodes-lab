      "typeVersion": 1.3,
      "position": [
        -272,
        448
      ],
      "id": "de626b01-582c-4f15-8359-d60ed6470a10",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item, index) => {\n  const data = item.json;\n\n  // Explicitly preserve all original email fields from Gmail Trigger\n  const id = data.id;\n  const threadId = data.threadId;\n  const from = data.from;\n  const to = data.to;\n  const subject = data.subject;\n  const date = data.date;\n  const snippet = data.snippet;\n  const textPlain = data.textPlain;\n  const textHtml = data.textHtml;\n  const labelIds = data.labelIds;\n  const sizeEstimate = data.sizeEstimate;\n  const internalDate = data.internalDate;\n  const headers = data.headers;\n  const attachments = data.attachments;\n\n  // Build combined text for keyword matching\n  const body = (textPlain || textHtml || \"\").toString();\n  const fullText = `${subject || \"\"} ${body}`.toLowerCase();\n\n  // Keyword sets for each department\n  const keywords = {\n    \"Sales\": [\n      \"sale\", \"sales\", \"quote\", \"pricing\", \"price\", \"purchase\", \"order\",\n      \"deal\", \"discount\", \"proposal\", \"contract\", \"revenue\", \"lead\",\n      \"prospect\", \"negotiation\", \"invoice\", \"payment terms\"\n    ],\n    \"HR\": [\n      \"hr\", \"human resources\", \"payroll\", \"salary\", \"leave\", \"vacation\",\n      \"interview\", \"recruitment\", \"hiring\", \"onboarding\", \"resignation\",\n      \"benefits\", \"employee\", \"performance review\", \"contract renewal\",\n      \"sick leave\", \"promotion\"\n    ],\n    \"Marketing\": [\n      \"marketing\", \"campaign\", \"advertisement\", \"promotion\", \"branding\",\n      \"social media\", \"newsletter\", \"seo\", \"content\", \"influencer\",\n      \"launch\", \"press release\", \"audience\", \"engagement\", \"analytics\"\n    ],\n    \"Customer Service\": [\n      \"support\", \"customer\", \"complaint\", \"issue\", \"problem\", \"refund\",\n      \"return\", \"help\", \"ticket\", \"feedback\", \"service\", \"assistance\",\n      \"trouble\", \"not working\", \"broken\", \"delay\", \"cancellation\"\n    ]\n  };\n\n  // Score each department based on number of keyword matches\n  const scores = {};\n\n  for (const [department, words] of Object.entries(keywords)) {\n    scores[department] = words.reduce((count, word) => {\n      return fullText.includes(word) ? count + 1 : count;\n    }, 0);\n  }\n\n  // Find the department with the highest score\n  let category = \"Unclassified\";\n  let maxScore = 0;\n\n  for (const [department, score] of Object.entries(scores)) {\n    if (score > maxScore) {\n      maxScore = score;\n      category = department;\n    }\n  }\n\n  return {\n    json: {\n      // Explicitly preserved original fields\n      id,\n      threadId,\n      from,\n      to,\n      subject,\n      date,\n      snippet,\n      textPlain,\n      textHtml,\n      labelIds,\n      sizeEstimate,\n      internalDate,\n      headers,\n      attachments,\n\n      // Additional fields for downstream nodes\n      body,\n      category,\n      categoryScores: scores\n    },\n    pairedItem: index\n  };\n});"
      },
