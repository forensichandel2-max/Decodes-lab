            {
              "content": "=You are a text classification AI.\nClassify the customer feedback into exactly one category:\npositive\nnegative\nneutral\n\nFeedback:\n{{ $json.questions.ccnm.value }}\n\nReturn only the category, in lowercase, with no punctuation or extra text."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
