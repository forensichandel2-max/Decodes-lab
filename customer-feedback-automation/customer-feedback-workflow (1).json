        208,
        0
      ],
      "id": "62cbf3c1-c5b5-43fa-b2d9-17928b2daaff",
      "name": "Message a model",
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const text = (item.json.text || \"\").toLowerCase();\n  const category = (item.json.category || \"\").toLowerCase();\n\n  // Negative keywords\n  const negativeWords = [\n    \"bad\",\n    \"poor\",\n    \"terrible\",\n    \"awful\",\n    \"disappointed\",\n    \"unhappy\",\n    \"slow\",\n    \"worst\",\n    \"hate\",\n    \"complaint\",\n    \"issue\",\n    \"problem\"\n  ];\n\n  // Positive keywords\n  const positiveWords = [\n    \"good\",\n    \"great\",\n    \"excellent\",\n    \"amazing\",\n    \"happy\",\n    \"satisfied\",\n    \"love\",\n    \"fantastic\",\n    \"awesome\",\n    \"recommend\"\n  ];\n\n  let sentiment = \"Neutral\";\n\n  // Check category first\n  if (category.includes(\"negative\")) {\n    sentiment = \"Negative\";\n  } else if (category.includes(\"positive\")) {\n    sentiment = \"Positive\";\n  } else {\n    // Check text content\n    const hasNegative = negativeWords.some(word => text.includes(word));\n    const hasPositive = positiveWords.some(word => text.includes(word));\n\n    if (hasNegative) {\n      sentiment = \"Negative\";\n    } else if (hasPositive) {\n      sentiment = \"Positive\";\n    }\n  }\n\n  return {\n    json: {\n      ...item.json,\n      sentiment\n    }\n  };\n});"
      },
