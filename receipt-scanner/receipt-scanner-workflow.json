    {
      "parameters": {
        "jsCode": "// Get the original form data\nconst formData = $('Code in JavaScript').first().json;\n\n// Get the AI response text\nconst aiText = $input.first().json.output?.[0]?.content?.[0]?.text || '';\n\n// Parse the JSON from AI response\nlet extracted = {};\ntry {\n  // Clean any potential markdown fences just in case\n  const cleaned = aiText.replace(/```json|```/g, '').trim();\n  extracted = JSON.parse(cleaned);\n} catch (e) {\n  extracted = {\n    vendor: null,\n    date: null,\n    total_amount: null,\n    currency: null,\n    category: null,\n    items: null,\n    payment_method: null,\n    receipt_number: null\n  };\n}\n\nreturn [{\n  json: {\n    submittedBy: formData.fullName,\n    receiptImageUrl: formData.receiptImageUrl,\n    notes: formData.notes,\n    vendor: extracted.vendor,\n    date: extracted.date,\n    totalAmount: extracted.total_amount,\n    currency: extracted.currency,\n    category: extracted.category,\n    items: extracted.items,\n    paymentMethod: extracted.payment_method,\n    receiptNumber: extracted.receipt_number\n  }\n}];"
      },
