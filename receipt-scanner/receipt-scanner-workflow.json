        },
        "responses": {
          "values": [
            {
              "content": "=Image: {{ $json.receiptImageUrl }}\nText : You are a receipt and invoice data extraction assistant. \n\nCarefully analyze this receipt/invoice image and extract ALL available information.\n\nReturn ONLY valid JSON in this exact format — no markdown, no extra text:\n\n{\n  \"vendor\": \"Store or company name\",\n  \"date\": \"Date on receipt (YYYY-MM-DD format if possible)\",\n  \"total_amount\": 0.00,\n  \"currency\": \"USD\",\n  \"category\": \"one of: Food, Travel, Office Supplies, Utilities, Entertainment, Medical, Shopping, Other\",\n  \"items\": \"Comma-separated list of items purchased\",\n  \"payment_method\": \"Cash/Card/Transfer etc if visible\",\n  \"receipt_number\": \"Receipt or invoice number if visible, otherwise null\"\n}\n\nIf any field is not visible or unclear on the receipt, use null for that field."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
