      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst questions = data.questions;\n\n// Extract each field by name\nconst fullName = Object.values(questions).find(q => q.name === 'Full Name')?.value || '';\nconst receiptImageUrl = Object.values(questions).find(q => q.name === 'Receipt Image')?.value?.[0]?.url || '';\nconst notes = Object.values(questions).find(q => q.name === 'Notes')?.value || '';\n\nreturn [{\n  json: {\n    fullName,\n    receiptImageUrl,\n    notes\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
