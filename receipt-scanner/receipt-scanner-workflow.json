        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 500px; margin: 0 auto; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden;\">\n\n  <div style=\"background-color: #1976d2; color: #ffffff; padding: 16px 24px;\">\n    <h2 style=\"margin: 0;\">🧾 New Receipt Logged</h2>\n  </div>\n\n  <div style=\"padding: 24px;\">\n    <p style=\"font-size: 15px; color: #333;\">A new receipt has been scanned and logged automatically.</p>\n\n    <table style=\"width: 100%; border-collapse: collapse; margin-top: 16px;\">\n      <tr>\n        <td style=\"padding: 8px; font-weight: bold; width: 140px; border-bottom: 1px solid #eee;\">Vendor</td>\n        <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ $('Code in JavaScript1').item.json.vendor }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px; font-weight: bold; border-bottom: 1px solid #eee;\">Date</td>\n        <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ $('Code in JavaScript1').item.json.date }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px; font-weight: bold; border-bottom: 1px solid #eee;\">Amount</td>\n        <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ $('Code in JavaScript1').item.json.totalAmount }} {{ $('Code in JavaScript1').item.json.currency }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px; font-weight: bold; border-bottom: 1px solid #eee;\">Category</td>\n        <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ $('Code in JavaScript1').item.json.category }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px; font-weight: bold; border-bottom: 1px solid #eee;\">Items</td>\n        <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ $('Code in JavaScript1').item.json.items }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px; font-weight: bold; border-bottom: 1px solid #eee;\">Payment Method</td>\n        <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ $('Code in JavaScript1').item.json.paymentMethod }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px; font-weight: bold; border-bottom: 1px solid #eee;\">Receipt Number</td>\n        <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ $('Code in JavaScript1').item.json.receiptNumber }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px; font-weight: bold; border-bottom: 1px solid #eee;\">Submitted By</td>\n        <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">{{ $('Code in JavaScript1').item.json.submittedBy }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px; font-weight: bold;\">Notes</td>\n        <td style=\"padding: 8px;\">{{ $('Code in JavaScript1').item.json.notes }}</td>\n      </tr>\n    </table>\n\n    <p style=\"margin-top: 24px; font-size: 13px; color: #777;\">\n      This notification was generated automatically by the Receipt Scanner workflow.\n    </p>\n  </div>\n\n</div>",
