    {
      "parameters": {
        "jsCode": "const data = $input.first()?.json;\n\nif (!data || !data.questions) {\n  return [{\n    json: {\n      fullName: '',\n      email: '',\n      age: '',\n      conditions: '',\n      medications: '',\n      allergies: '',\n      prescribingDoctor: ''\n    }\n  }];\n}\n\nconst questions = data.questions;\n\nconst getAnswer = (name) =>\n  Object.values(questions).find(q => q.name === name)?.value || '';\n\nreturn [{\n  json: {\n    fullName: getAnswer('Full Name'),\n    email: getAnswer('Email'),\n    age: getAnswer('Age'),\n    conditions: getAnswer('Medical Conditions'),\n    medications: getAnswer('Current Medications'),\n    allergies: getAnswer('Allergies'),\n    prescribingDoctor: getAnswer('Prescribing Doctor')\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 64],
      "id": "c4d525a4-6f2e-468d-9bb3-1d42a29063a0",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "GPT-4.1-MINI"
        },
        "responses": {
          "values": [
            {
              "content": "=You are a clinical pharmacy AI assistant.\nAnalyze the following patient medication profile and:\n\n1. Check for potential drug-drug interactions\n2. Check for drug-condition contraindications\n3. Classify overall risk as: HIGH, MEDIUM, or LOW\n4. Provide a clear clinical summary\n\nPatient Name: {{ $json.fullName }}\nPatient Age: {{ $json.age }}\nMedical Conditions: {{ $json.conditions }}\nCurrent Medications: {{ $json.medications }}\nAllergies: {{ $json.allergies }}\nPrescribing Doctor: {{ $json.prescribingDoctor }}\n\nReturn ONLY valid JSON in this exact format — no markdown, no extra text:\n\n{\n  \"riskLevel\": \"HIGH\",\n  \"interactions\": [\"interaction 1\", \"interaction 2\"],\n  \"contraindications\": [\"contraindication 1\"],\n  \"recommendations\": [\"recommendation 1\", \"recommendation 2\"],\n  \"clinicalSummary\": \"2-3 sentence professional summary\"\n}\n\nIf no interactions or contraindications found, return empty arrays []."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [448, 64],
      "id": "1c4c9064-0944-4175-a619-8097f2f5b0b6",
      "name": "Message a model",
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const patientData = $('Code in JavaScript').first().json;\nconst aiText = $input.first().json.output?.[0]?.content?.[0]?.text || '';\n\nlet analysis = {};\ntry {\n  const cleaned = aiText.replace(/```json|```/g, '').trim();\n  analysis = JSON.parse(cleaned);\n} catch (e) {\n  analysis = {\n    riskLevel: 'UNKNOWN',\n    interactions: [],\n    contraindications: [],\n    recommendations: [],\n    clinicalSummary: 'Unable to parse analysis'\n  };\n}\n\nreturn [{\n  json: {\n    fullName: patientData.fullName,\n    email: patientData.email,\n    age: patientData.age,\n    conditions: patientData.conditions,\n    medications: patientData.medications,\n    allergies: patientData.allergies,\n    prescribingDoctor: patientData.prescribingDoctor,\n    riskLevel: analysis.riskLevel,\n    interactions: analysis.interactions.join(', ') || 'None identified',\n    contraindications: analysis.contraindications.join(', ') || 'None identified',\n    recommendations: analysis.recommendations.join('. ') || 'None',\n    clinicalSummary: analysis.clinicalSummary\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 64],
