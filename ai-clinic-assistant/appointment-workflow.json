    {
      "parameters": {
        "jsCode": "const agentResponse = $input.first().json.output || '';\n\nconst extractField = (text, label) => {\n  const regex = new RegExp(`${label}[:\\\\s]+([^\\\\n]+)`, 'i');\n  const match = text.match(regex);\n  return match ? match[1].trim() : null;\n};\n\nconst doctor = extractField(agentResponse, 'Doctor');\nconst specialty = extractField(agentResponse, 'Specialty');\nconst day = extractField(agentResponse, 'Day');\nconst time = extractField(agentResponse, 'Time');\nconst location = extractField(agentResponse, 'Location');\nconst queueNumber = extractField(agentResponse, 'Queue Number');\n\nreturn [{\n  json: {\n    agentResponse,\n    doctor,\n    specialty,\n    day,\n    time,\n    location,\n    queueNumber\n  }\n}];"
      },
