      "id": "32943fa7-5d99-479e-b35a-aa6983289b4c",
      "name": "Course recommendation Engine",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const courses = items.map(item => item.json.course);\n\nlet roadmap = '';\n\ncourses.forEach((course,index)=>{\n\nroadmap += `${index+1}. ${course}\\n`;\n\n});\n\nreturn [{\njson:{\nroadmap\n}\n}];"
      },
      "type": "n8n-nodes-base.code",
