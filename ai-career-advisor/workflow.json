      "id": "66237f79-e2b5-4222-b9e4-b50af664c788",
      "name": "Roadmap Builder"
    },
    {
      "parameters": {
        "jsCode": "// Get the Fillout submission data\nconst filloutData = $('Fillout Trigger').first().json;\n\n// Convert questions object into an array\nconst questionsArray = Object.values(filloutData.questions);\n\n// Helper to get a value by question name\nconst getAnswer = (questionName) =>\n  questionsArray.find(q => q.name === questionName)?.value;\n\nconst userName = getAnswer('Full Name');\nconst userEmail = getAnswer('Email');\nconst userCareerGoal = getAnswer('Career Goal');\n\n// Get all learning paths from Airtable\nconst learningPaths = $('Get Learning Paths').all();\n\n// Find the matching learning path\nconst matchedPath = learningPaths.find(\n  item => item.json.fields['Career Goal']?.toLowerCase() === userCareerGoal?.toLowerCase()\n);\n\nif (!matchedPath) {\n  return [{\n    json: {\n      error: 'No matching learning path found',\n      userCareerGoal: userCareerGoal\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    userName: userName,\n    userEmail: userEmail,\n    careerGoal: matchedPath.json.fields['Career Goal'],\n    skillsRequired: matchedPath.json.fields['Skills']\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
